#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";
        window_controls {
            if-layers = <1 2>;
            then-layer = <3>;
        };
        maintenance_controls {
            if-layers = <1 2 4>;
            then-layer = <5>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // Blank = transparent (inherits); --- = no action.
            // |   ESC    |    1     |    2     |    3     |    4     |    5     |          |  |          |    6     |    7     |    8     |    9     |    0     |    `     |
            // |   TAB    |    Q     |    W     |    E     |    R     |    T     |          |  |          |    Y     |    U     |    I     |    O     |    P     |    -     |
            // |   CTRL   |    A     |    S     |    D     |    F     |    G     |          |  |          |    H     |    J     |    K     |    L     |    ;     |    '     |
            // |  SHIFT   |    Z     |    X     |    C     |    V     |    B     |    [     |  |    ]     |    N     |    M     |    ,     |    .     |    /     |  SHIFT   |
            // |          |          |   OPT    |   CMD    |  LOWER   |  SPACE   |          |  |          |  ENTER   |  RAISE   |   BSPC   |   CMD    |          |          |
            bindings = <
                &kp ESC    &kp N1  &kp N2    &kp N3    &kp N4  &kp N5                         &kp N6   &kp N7  &kp N8     &kp N9    &kp N0    &kp GRAVE
                &kp TAB    &kp Q   &kp W     &kp E     &kp R   &kp T                          &kp Y    &kp U   &kp I      &kp O     &kp P     &kp MINUS
                &kp LCTRL  &kp A   &kp S     &kp D     &kp F   &kp G                          &kp H    &kp J   &kp K      &kp L     &kp SEMI  &kp SQT
                &kp LSHFT  &kp Z   &kp X     &kp C     &kp V   &kp B      &kp LBKT  &kp RBKT  &kp N    &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
                                   &kp LALT  &kp LGUI  &mo 1   &kp SPACE                      &kp RET  &mo 2   &kp BSPC   &kp RGUI
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        lower_layer {
            // LOWER + Z: external power on; Grave: Bluetooth clear; Backspace: Delete.
            // LOWER + either inner bracket: reset that half.
            // Blank = transparent (inherits); --- = no action.
            // |          |   BT 1   |   BT 2   |   BT 3   |   BT 4   |   BT 5   |          |  |          |          |          |          |          |          | BT CLEAR |
            // |    F1    |    F2    |    F3    |    F4    |    F5    |    F6    |          |  |          |    F7    |    F8    |    F9    |   F10    |   F11    |   F12    |
            // |    `     |    !     |    @     |    #     |    $     |    %     |          |  |          |    ^     |    &     |    *     |    (     |    )     |    ~     |
            // |          |  PWR ON  |          |          |          |          |  RESET   |  |  RESET   |          |    -     |    +     |    {     |    }     |   PIPE   |
            // |          |          |          |          |          |          |          |  |          |          |          |  DELETE  |          |          |          |
            bindings = <
                &trans     &bt BT_SEL 0      &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                          &trans     &trans     &trans     &trans    &trans    &bt BT_CLR
                &kp F1     &kp F2            &kp F3        &kp F4        &kp F5        &kp F6                                &kp F7     &kp F8     &kp F9     &kp F10   &kp F11   &kp F12
                &kp GRAVE  &kp EXCL          &kp AT        &kp HASH      &kp DOLLAR    &kp PRCNT                             &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR  &kp TILDE
                &trans     &ext_power EP_ON  &trans        &trans        &trans        &trans        &sys_reset  &sys_reset  &trans     &kp MINUS  &kp PLUS   &kp LBRC  &kp RBRC  &kp PIPE
                                             &trans        &trans        &trans        &trans                                &trans     &trans     &kp DEL    &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        raise_layer {
            // Top-right row (6, 7, 8, 9, 0, Grave):
            // Previous, Play/Pause, Next, Volume Up, Volume Down, Mute.
            // Arrows: I = Up; J = Left; K = Down; L = Right.
            // Inner bracket keys inherit their base-layer bracket characters.
            // Former second-row number bindings now fall through to base letters.
            // Blank = transparent (inherits); --- = no action.
            // |          |          |          |          |          |          |          |  |          |   PREV   |PLAY/PAUSE|   NEXT   |   VOL+   |   VOL-   |   MUTE   |
            // |    `     |          |          |          |          |          |          |  |          |          |          |    UP    |          |          |          |
            // |          |          |          |          |          |          |          |  |          |          |   LEFT   |   DOWN   |  RIGHT   |          |          |
            // |          |          |          |          |          |          |          |  |          |   KP+    |    -     |    =     |    [     |    ]     |    \     |
            // |          |          |          |          |          |          |          |  |          |          |          |          |          |          |          |
            bindings = <
                &trans     &trans  &trans  &trans   &trans   &trans                   &kp C_PREV   &kp C_PP   &kp C_NEXT  &kp C_VOL_UP  &kp C_VOL_DN  &kp C_MUTE
                &kp GRAVE  &trans  &trans  &trans   &trans   &trans                   &trans       &trans     &kp UP      &trans        &trans        &trans
                &trans     &trans  &trans  &trans   &trans   &trans                   &trans       &kp LEFT   &kp DOWN    &kp RIGHT     &trans        &trans
                &trans     &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp KP_PLUS  &kp MINUS  &kp EQUAL   &kp LBKT      &kp RBKT      &kp BSLH
                                   &trans  &trans   &trans   &trans                   &trans       &trans     &trans      &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        window_layer {
            // Hold LOWER + RAISE, in either order; release either to leave.
            // Rectangle: I/J/K/L = halves; T/E = right/left two-thirds.
            // Hold Esc to arm maintenance; unassigned finger keys do nothing.
            // Blank = transparent (inherits); --- = no action.
            // |MAINT HOLD|   ---    |   ---    |   ---    |   ---    |   ---    |          |  |          |   ---    |   ---    |   ---    |   ---    |   ---    |   ---    |
            // |   ---    |   ---    |   ---    | LEFT 2/3 |   ---    |RIGHT 2/3 |          |  |          |   ---    |   ---    | TOP 1/2  |   ---    |   ---    |   ---    |
            // |   ---    |   ---    |   ---    |   ---    |   ---    |   ---    |          |  |          |   ---    | LEFT 1/2 |BOTTOM 1/2|RIGHT 1/2 |   ---    |   ---    |
            // |   ---    |   ---    |   ---    |   ---    |   ---    |   ---    |   ---    |  |   ---    |   ---    |   ---    |   ---    |   ---    |   ---    |   ---    |
            // |          |          |          |          |          |          |          |  |          |          |          |          |          |          |          |
            bindings = <
                &mo 4  &none  &none   &none          &none   &none                        &none   &none             &none             &none              &none  &none
                &none  &none  &none   &kp LC(LA(E))  &none   &kp LC(LA(T))                &none   &none             &kp LC(LA(UP))    &none              &none  &none
                &none  &none  &none   &none          &none   &none                        &none   &kp LC(LA(LEFT))  &kp LC(LA(DOWN))  &kp LC(LA(RIGHT))  &none  &none
                &none  &none  &none   &none          &none   &none          &none  &none  &none   &none             &none             &none              &none  &none
                              &trans  &trans         &trans  &trans                       &trans  &trans            &trans            &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        maintenance_arm_layer {
            // Internal arming layer. Bootloader remains blocked unless LOWER and RAISE are both held.
            // Blank = transparent (inherits); --- = no action.
            // |          |   ---    |   ---    |   ---    |   ---    |   ---    |          |  |          |   ---    |   ---    |   ---    |   ---    |   ---    |   ---    |
            // |   ---    |   ---    |   ---    |   ---    |   ---    |   ---    |          |  |          |   ---    |   ---    |   ---    |   ---    |   ---    |   ---    |
            // |   ---    |   ---    |   ---    |   ---    |   ---    |   ---    |          |  |          |   ---    |   ---    |   ---    |   ---    |   ---    |   ---    |
            // |   ---    |   ---    |   ---    |   ---    |   ---    |   ---    |   ---    |  |   ---    |   ---    |   ---    |   ---    |   ---    |   ---    |   ---    |
            // |          |          |   ---    |   ---    |          |   ---    |          |  |          |   ---    |          |   ---    |   ---    |          |          |
            bindings = <
                &trans  &none  &none  &none  &none   &none                &none  &none   &none  &none  &none  &none
                &none   &none  &none  &none  &none   &none                &none  &none   &none  &none  &none  &none
                &none   &none  &none  &none  &none   &none                &none  &none   &none  &none  &none  &none
                &none   &none  &none  &none  &none   &none  &none  &none  &none  &none   &none  &none  &none  &none
                               &none  &none  &trans  &none                &none  &trans  &none  &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        maintenance_layer {
            // Hold LOWER + RAISE, then hold Esc, then tap the target half's inner bracket. Release any hold to disarm.
            // Blank = transparent (inherits); --- = no action.
            // |          |   ---    |   ---    |   ---    |   ---    |   ---    |          |  |          |   ---    |   ---    |   ---    |   ---    |   ---    |   ---    |
            // |   ---    |   ---    |   ---    |   ---    |   ---    |   ---    |          |  |          |   ---    |   ---    |   ---    |   ---    |   ---    |   ---    |
            // |   ---    |   ---    |   ---    |   ---    |   ---    |   ---    |          |  |          |   ---    |   ---    |   ---    |   ---    |   ---    |   ---    |
            // |   ---    |   ---    |   ---    |   ---    |   ---    |   ---    |   BOOT   |  |   BOOT   |   ---    |   ---    |   ---    |   ---    |   ---    |   ---    |
            // |          |          |   ---    |   ---    |          |   ---    |          |  |          |   ---    |          |   ---    |   ---    |          |          |
            bindings = <
                &trans  &none  &none  &none  &none   &none                            &none  &none   &none  &none  &none  &none
                &none   &none  &none  &none  &none   &none                            &none  &none   &none  &none  &none  &none
                &none   &none  &none  &none  &none   &none                            &none  &none   &none  &none  &none  &none
                &none   &none  &none  &none  &none   &none  &bootloader  &bootloader  &none  &none   &none  &none  &none  &none
                               &none  &none  &trans  &none                            &none  &trans  &none  &none
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
